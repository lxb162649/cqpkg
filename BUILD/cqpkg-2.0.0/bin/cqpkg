#!/bin/bash

BASE_DIR="/usr/share/cqpkg"
source "$BASE_DIR/config/constants.sh"

# 主函数
main() {
    # 初始化环境
    trap handle_interrupt SIGINT SIGTERM

    # 解析参数
    parse_args "$@"

    # 定义目录路径
    PKG=$(basename $PKG_PATH)

    # 检查clone_flag，为1则克隆
    if [ "$clone_flag" == "1" ]; then
        module_clone
        exit 0
    fi

    BUILD_DIR=$PKG_PATH/BUILD
    SOURCES_DIR=$PKG_PATH/SOURCES
    SPECS_DIR=$PKG_PATH/SPECS
    RPM_DIR=$PKG_PATH/RPMS

    # 定义spec文件路径及展开宏定义后的spec路径
    SPEC_FILE=$(ls $SPECS_DIR/*.spec)

    NEW_SPEC_FILE="$SPEC_FILE-new"
    
    # 主流程
    log_action "开始对包 $PKG 处理"
    log_info "PKG_PATH: $PKG_PATH"
    log_info "操作模式: $ACTION"
    log_info "================================"

    # 根据选择的操作模式执行相应的功能
    case "$ACTION" in
        clone)
            module_clone
            ;;
        patch)
            module_patch
            ;;
        compile)
            module_compile
            ;;
        upload)
            module_upload
            ;;
        reupload)
            cd $PKG_PATH
            git reset --soft HEAD~1 && log_info "重置提交成功！"
            module_upload
            ;;
        merge_request)
            module_merge_request
            ;;
        *)
            log_error "错误: 未知操作模式 '$ACTION'"
            ;;
    esac

    log_action "所有操作已完成"
}

main "$@"
